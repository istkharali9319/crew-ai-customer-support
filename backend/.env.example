# Copy this file to .env and fill in your key. Never commit .env.

# Default provider (config/agent.json uses openai/gpt-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: use a different model without editing agent.json
# LLM_MODEL=anthropic/claude-opus-5-5
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Websites allowed to call this API (the React dev server)
FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
